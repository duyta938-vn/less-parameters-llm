<!DOCTYPE html><html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Shop Bán Áo - Duy Store</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      margin: 0;
      padding: 0;
      background: #f5f5f5;
    }
    header {
      background: black;
      color: white;
      padding: 20px;
      text-align: center;
      font-size: 24px;
    }
    .container {
      padding: 20px;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 20px;
    }
    .card {
      background: white;
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 4px 10px rgba(0,0,0,0.1);
      padding-bottom: 15px;
      text-align: center;
    }
    .card img {
      width: 100%;
      height: 250px;
      object-fit: cover;
    }
    .card h3 {
      margin: 10px;
      font-size: 20px;
    }
    .price {
      color: green;
      font-size: 18px;
      margin-bottom: 10px;
    }
    button {
      background: black;
      color: white;
      border: none;
      padding: 10px 18px;
      cursor: pointer;
      border-radius: 8px;
      font-size: 16px;
    }
    button:hover {
      opacity: 0.8;
    }
  </style>
</head>
<body>
  <header>🛒 Duy Clothing Store</header>  <div class="container">
    <div class="card">
      <img src="https://i.imgur.com/nQn4Z9E.jpeg" alt="Áo 1" />
      <h3>Áo Thể Thao 2025</h3>
      <div class="price">199.000₫</div>
      <button>Đặt mua</button>
    </div><div class="card">
  <img src="https://i.imgur.com/6XK7m0J.jpeg" alt="Áo 2" />
  <h3>Áo Form Rộng</h3>
  <div class="price">159.000₫</div>
  <button>Đặt mua</button>
</div>

<div class="card">
  <img src="https://i.imgur.com/ITvH5rn.jpeg" alt="Áo 3" />
  <h3>Áo Hoodie Basic</h3>
  <div class="price">249.000₫</div>
  <button>Đặt mua</button>
</div>

  </div>
</body>
</html>
